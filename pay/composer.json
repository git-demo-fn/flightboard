{
    "name": "flightboard/pay",
    "description": "Flightboard pay service: computes work order pay.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Flightboard\\Pay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flightboard\\Pay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8782 public/index.php"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
